<archimate:ArchimateDiagramModel
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:archimate="http://www.archimatetool.com/archimate"
    name="Archi Workspace - Collaboration Flow"
    id="id-example-view-collaboration-flow">
  <children
      xsi:type="archimate:DiagramModelArchimateObject"
      id="id-example-do-team"
      fillColor="#fff2cc">
    <sourceConnections
        xsi:type="archimate:DiagramModelArchimateConnection"
        id="id-example-dc-models"
        source="id-example-do-team"
        target="id-example-do-archi">
      <archimateRelationship
          xsi:type="archimate:AssociationRelationship"
          href="AssociationRelationship_id-example-rel-models-with.xml#id-example-rel-models-with"/>
    </sourceConnections>
    <bounds x="36" y="72" width="176" height="64"/>
    <archimateElement
        xsi:type="archimate:BusinessActor"
        href="BusinessActor_id-example-team-member.xml#id-example-team-member"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelArchimateObject"
      id="id-example-do-archi"
      targetConnections="id-example-dc-models"
      fillColor="#b5d9f2">
    <sourceConnections
        xsi:type="archimate:DiagramModelArchimateConnection"
        id="id-example-dc-collab"
        source="id-example-do-archi"
        target="id-example-do-coarchi">
      <archimateRelationship
          xsi:type="archimate:AssociationRelationship"
          href="AssociationRelationship_id-example-rel-collaborates-through.xml#id-example-rel-collaborates-through"/>
    </sourceConnections>
    <bounds x="284" y="72" width="176" height="64"/>
    <archimateElement
        xsi:type="archimate:ApplicationComponent"
        href="ApplicationComponent_id-example-archi-desktop.xml#id-example-archi-desktop"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelArchimateObject"
      id="id-example-do-coarchi"
      targetConnections="id-example-dc-collab"
      fillColor="#b5d9f2">
    <sourceConnections
        xsi:type="archimate:DiagramModelArchimateConnection"
        id="id-example-dc-sync"
        source="id-example-do-coarchi"
        target="id-example-do-github">
      <archimateRelationship
          xsi:type="archimate:AssociationRelationship"
          href="AssociationRelationship_id-example-rel-syncs-to.xml#id-example-rel-syncs-to"/>
    </sourceConnections>
    <bounds x="532" y="72" width="176" height="64"/>
    <archimateElement
        xsi:type="archimate:ApplicationComponent"
        href="ApplicationComponent_id-example-coarchi.xml#id-example-coarchi"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelArchimateObject"
      id="id-example-do-github"
      targetConnections="id-example-dc-sync"
      fillColor="#c9e7b7">
    <sourceConnections
        xsi:type="archimate:DiagramModelArchimateConnection"
        id="id-example-dc-publish"
        source="id-example-do-github"
        target="id-example-do-publisher">
      <archimateRelationship
          xsi:type="archimate:AssociationRelationship"
          href="AssociationRelationship_id-example-rel-publishes-from.xml#id-example-rel-publishes-from"/>
    </sourceConnections>
    <bounds x="780" y="72" width="176" height="64"/>
    <archimateElement
        xsi:type="archimate:TechnologyService"
        href="TechnologyService_id-example-github-repository.xml#id-example-github-repository"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelArchimateObject"
      id="id-example-do-publisher"
      targetConnections="id-example-dc-publish"
      fillColor="#b5d9f2">
    <sourceConnections
        xsi:type="archimate:DiagramModelArchimateConnection"
        id="id-example-dc-generate"
        source="id-example-do-publisher"
        target="id-example-do-report">
      <archimateRelationship
          xsi:type="archimate:AssociationRelationship"
          href="AssociationRelationship_id-example-rel-generates.xml#id-example-rel-generates"/>
    </sourceConnections>
    <bounds x="780" y="248" width="176" height="64"/>
    <archimateElement
        xsi:type="archimate:ApplicationComponent"
        href="ApplicationComponent_id-example-report-publisher.xml#id-example-report-publisher"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelArchimateObject"
      id="id-example-do-report"
      targetConnections="id-example-dc-generate"
      fillColor="#c9e7b7">
    <sourceConnections
        xsi:type="archimate:DiagramModelArchimateConnection"
        id="id-example-dc-distribute"
        source="id-example-do-report"
        target="id-example-do-sharepoint">
      <archimateRelationship
          xsi:type="archimate:AssociationRelationship"
          href="AssociationRelationship_id-example-rel-distributes.xml#id-example-rel-distributes"/>
    </sourceConnections>
    <bounds x="532" y="248" width="176" height="64"/>
    <archimateElement
        xsi:type="archimate:Artifact"
        href="Artifact_id-example-html-report.xml#id-example-html-report"/>
  </children>
  <children
      xsi:type="archimate:DiagramModelArchimateObject"
      id="id-example-do-sharepoint"
      targetConnections="id-example-dc-distribute"
      fillColor="#f8cecc">
    <bounds x="284" y="248" width="176" height="64"/>
    <archimateElement
        xsi:type="archimate:ApplicationComponent"
        href="ApplicationComponent_id-example-sharepoint.xml#id-example-sharepoint"/>
  </children>
</archimate:ArchimateDiagramModel>
